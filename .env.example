# Copy to .env for local development and set the same values in Vercel > Settings > Environment Variables.
# These are public (client-side) keys — safe to expose in the browser, but keep the real .env out of git.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
